#!/usr/bin/env bash
# Generated by webterm-kit installer. Edit install.sh / templates and re-run instead.
#
# v2: ttyd binds 127.0.0.1 only. Caddy on :443 handles TLS + path routing.
# --base-path tells ttyd the URL prefix it's mounted under so WebSocket URLs
# resolve correctly behind the reverse proxy.
exec ttyd -i 127.0.0.1 -p __PORT__ -W -a \
  -b __BASE_PATH__ \
  -t fontSize=20 \
  -t 'fontFamily=Menlo, "JetBrains Mono", "SF Mono", Monaco, "Apple Color Emoji", "Apple Symbols", "Hiragino Sans", "Symbola", monospace' \
  -t rendererType=dom \
  -t cursorBlink=true \
  -t cursorStyle=bar \
  -t macOptionIsMeta=true \
  -t scrollback=10000 \
  -t disableLeaveAlert=true \
  -t 'theme={"background": "#0b0b0f"}' \
  __CMD__
